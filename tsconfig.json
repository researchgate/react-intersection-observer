{
  "compilerOptions": {
    "target": "ES2018",
    "moduleResolution": "node",
    "module": "ES2020",
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noImplicitThis": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "jsx": "react",
    "rootDir": "src",
    "declarationDir": "./typings",
    "outDir": "./lib/es",
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
